{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm generate-routes && vite",
    "build": "pnpm generate-routes &&  vite build",
    "preview": "vite preview",
    "fmt": "dprint fmt && prettier --write \"src/**/*.vue\" && stylelint \"src/**/*.{css,vue}\" --fix",
    "fmt:dprint": "dprint fmt",
    "fmt:check": "dprint check && prettier --check \"src/**/*.vue\"",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx,vue}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx,js,jsx,vue}\"",
    "stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "prepare": "husky install",
    "generate-routes": "node ./scripts/auto-import-routes.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@highlightjs/vue-plugin": "^2.1.0",
    "@tanstack/vue-query": "^5.92.1",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.9",
    "highlight.js": "^11.11.1",
    "lodash-es": "^4.17.21",
    "mockjs": "^1.1.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "uuid": "^13.0.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "vue3-slide-verify": "^1.1.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@types/lodash-es": "^4.17.12",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^24.10.1",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@unocss/preset-attributify": "66.5.10-beta.1",
    "@unocss/preset-icons": "66.5.10-beta.1",
    "@unocss/preset-wind": "66.5.10-beta.1",
    "@unocss/transformer-variant-group": "66.5.10-beta.1",
    "@unocss/vite": "66.5.10-beta.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "@vue/tsconfig": "^0.8.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "dprint": "^0.50.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "fast-glob": "^3.3.3",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "less": "^4.5.1",
    "lint-staged": "^16.2.7",
    "postcss-html": "^1.8.0",
    "prettier": "^3.7.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sass-embedded": "^1.93.3",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-scss": "^6.12.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "unocss": "66.5.10-beta.1",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-element-plus": "^0.11.1",
    "unplugin-vue-components": "^30.0.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-env-parse": "^1.0.15",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "dprint fmt --allow-no-files"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --fix",
      "stylelint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "dprint fmt  --allow-no-files"
    ]
  }
}
