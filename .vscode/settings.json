{
  // =============================================
  // 全局格式化控制（避免冲突）
  // =============================================
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never"
  },
  "[vue]": {
    "files.eol": "\n",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "dprint.path": "/path/to/dprint",
  "prettier.enable": true,
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": false,
  "[typescript]": { "editor.defaultFormatter": "dprint.dprint" },
  "[javascript]": { "editor.defaultFormatter": "dprint.dprint" },
  "[javascriptreact]": { "editor.defaultFormatter": "dprint.dprint" },
  "[typescriptreact]": { "editor.defaultFormatter": "dprint.dprint" },
  "[json]": { "editor.defaultFormatter": "dprint.dprint" },
  "[jsonc]": { "editor.defaultFormatter": "dprint.dprint" },
  "[markdown]": { "editor.defaultFormatter": "dprint.dprint" },
  "[yaml]": { "editor.defaultFormatter": "dprint.dprint" },

  // =============================================
  // Stylelint —— 仅提示，不自动 fix
  // =============================================
  "stylelint.validate": ["css", "scss", "less", "vue"],
  "stylelint.enable": true,

  // =============================================
  // ESLint —— 只做提示，不修复
  // =============================================
  "eslint.enable": true,
  "eslint.run": "onType",
  "eslint.format.enable": false,
  "eslint.rules.customizations": [
    { "rule": "prettier/prettier", "severity": "warn" }
  ],

  // =============================================
  // Tailwind IntelliSense —— 新配置
  // =============================================
  "tailwindCSS.includeLanguages": {
    "vue": "html",
    "typescript": "javascript"
  },
  "tailwindCSS.emmetCompletions": true,
  "editor.quickSuggestions": {
    "strings": true
  },

  // 支持 class 嵌套语法（如 hover:(bg-red-500 text-white)）
  "tailwindCSS.experimental.classRegex": [
    ["class\\s*=\\s*\"([^\"]*)\"", "(?:^|\\s)([^\\s]+)"]
  ],

  // =============================================
  // 性能优化（不会出现 unknown）
  // =============================================
  "editor.minimap.enabled": false,
  "editor.largeFileOptimizations": true,
  "typescript.tsserver.maxTsServerMemory": 2048,

  // =============================================
  // UI 优化
  // =============================================
  "editor.guides.indentation": true,
  "editor.renderWhitespace": "boundary",

  // =============================================
  // 修复 Delete '␍' eslint(prettier/prettier) 换行符的问题
  // =============================================
  "files.eol": "\n",

  // =============================================
  // 对更目录进行折叠，让目录看起来更清爽一点
  // =============================================
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "pnpm-lock.yaml, commitlint.config.js, .editorconfig, .gitattributes",
    "eslint.config.js": ".eslintrc-auto-import.json, prettier.config.js, .prettierignore, dprint.json, stylelint.config.js",
    "tsconfig.json": "tsconfig*.json",
    "README.md": "README_CN.md",
    ".env": ".env.*"
  }
}
